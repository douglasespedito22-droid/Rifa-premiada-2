create extension if not exists pgcrypto;

create table if not exists public.raffles (
 id uuid primary key default gen_random_uuid(), title text not null, description text not null default '',
 price numeric(10,2) not null check(price > 0), total_numbers integer not null check(total_numbers between 1 and 10000),
 draw_date timestamptz, status text not null default 'draft' check(status in ('draft','active','closed')),
 image_url text not null default '', created_at timestamptz not null default now()
);
create table if not exists public.site_settings (
 id integer primary key default 1 check(id=1), site_name text not null default 'Rifa 2º Alimentos',
 pix_key text not null default 'ifroalimentos.25@gmail.com', receiver_name text not null default 'Douglas Espedito da Silva Jesus',
 bank_name text not null default 'Mercado Pago', support_email text not null default 'ifroalimentos.25@gmail.com'
);
insert into public.site_settings(id) values(1) on conflict(id) do nothing;
create table if not exists public.orders (
 id uuid primary key default gen_random_uuid(), raffle_id uuid not null references public.raffles(id) on delete restrict,
 buyer_name text not null, buyer_email text not null, buyer_phone text not null default '', numbers integer[] not null,
 total_amount numeric(10,2) not null, status text not null default 'awaiting_proof'
 check(status in ('awaiting_proof','under_review','pending','paid','rejected','expired')),
 proof_path text, admin_notes text not null default '', created_at timestamptz not null default now(),
 expires_at timestamptz not null default (now()+interval '5 minutes'), reviewed_at timestamptz
);
create index if not exists orders_raffle_status_idx on public.orders(raffle_id,status);
create index if not exists orders_expires_idx on public.orders(expires_at);

alter table public.raffles enable row level security;
alter table public.site_settings enable row level security;
alter table public.orders enable row level security;
