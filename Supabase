create or replace function public.create_reservation(p_raffle_id uuid,p_numbers integer[],p_buyer_name text,p_buyer_email text,p_buyer_phone text default '')
returns jsonb language plpgsql security definer set search_path=public as $$
declare r public.raffles%rowtype; new_order public.orders%rowtype; n integer; begin
 if coalesce(array_length(p_numbers,1),0)<1 or array_length(p_numbers,1)>100 then raise exception 'Selecione de 1 a 100 cotas por pedido.'; end if;
 if coalesce(trim(p_buyer_name),'')='' or coalesce(trim(p_buyer_email),'')='' then raise exception 'Informe nome e e-mail.'; end if;
 if (select count(distinct x) from unnest(p_numbers) x) <> array_length(p_numbers,1) then raise exception 'Há números repetidos na seleção.'; end if;
 select * into r from public.raffles where id=p_raffle_id and status='active' for update;
 if not found then raise exception 'Esta rifa não está disponível.'; end if;
 if exists(select 1 from public.orders o cross join unnest(o.numbers) num where o.raffle_id=p_raffle_id and num=any(p_numbers) and (o.status='paid' or o.status='under_review' or (o.status in ('awaiting_proof','pending') and o.expires_at>now()))) then raise exception 'Uma ou mais cotas acabaram de ser reservadas. Atualize a página e escolha outras.'; end if;
 foreach n in array p_numbers loop if n<1 or n>r.total_numbers then raise exception 'Número de cota inválido.'; end if; end loop;
 insert into public.orders(raffle_id,buyer_name,buyer_email,buyer_phone,numbers,total_amount,status,expires_at)
 values(p_raffle_id,trim(p_buyer_name),trim(p_buyer_email),coalesce(trim(p_buyer_phone),''),p_numbers,r.price*array_length(p_numbers,1),'awaiting_proof',now()+interval '5 minutes') returning * into new_order;
 return jsonb_build_object('order_id',new_order.id,'numbers',new_order.numbers,'total_amount',new_order.total_amount,'expires_at',new_order.expires_at,'status',new_order.status);
end; $$;
grant execute on function public.create_reservation(uuid,integer[],text,text,text) to anon, authenticated;

create or replace function public.submit_payment_proof(p_order_id uuid,p_proof_path text)
returns void language plpgsql security definer set search_path=public as $$
declare o public.orders%rowtype; begin
 select * into o from public.orders where id=p_order_id for update;
 if not found then raise exception 'Pedido não encontrado.'; end if;
 if o.status not in ('awaiting_proof','pending') then raise exception 'Este pedido não aceita comprovante neste status.'; end if;
 if o.expires_at<now() then update public.orders set status='expired' where id=p_order_id; raise exception 'O prazo de reserva terminou. Faça um novo pedido.'; end if;
 if split_part(p_proof_path,'/',1)<>p_order_id::text then raise exception 'Arquivo de comprovante inválido.'; end if;
 update public.orders set proof_path=p_proof_path,status='under_review' where id=p_order_id;
end; $$;
grant execute on function public.submit_payment_proof(uuid,text) to anon, authenticated;

create or replace function public.admin_review_order(p_order_id uuid,p_status text,p_notes text default '')
returns void language plpgsql security definer set search_path=public as $$
declare o public.orders%rowtype; begin
 if auth.jwt()->>'email' <> 'ifroalimentos.25@gmail.com' then raise exception 'Acesso não autorizado.'; end if;
 if p_status not in ('paid','rejected','pending') then raise exception 'Status inválido.'; end if;
 select * into o from public.orders where id=p_order_id for update;
 if not found then raise exception 'Pedido não encontrado.'; end if;
 if p_status='paid' and o.proof_path is null then raise exception 'O pedido ainda não tem comprovante anexado.'; end if;
 if p_status='paid' and exists(select 1 from public.orders other cross join unnest(other.numbers) num where other.raffle_id=o.raffle_id and other.id<>o.id and num=any(o.numbers) and other.status='paid') then raise exception 'Uma ou mais cotas já foram confirmadas em outro pedido.'; end if;
 update public.orders set status=p_status,admin_notes=coalesce(p_notes,''),reviewed_at=now() where id=p_order_id;
end; $$;
grant execute on function public.admin_review_order(uuid,text,text) to authenticated;

